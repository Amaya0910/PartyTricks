rules_version = '2';

// Reglas de Cloud Firestore de Party Tricks.
// Ver docs/decisiones.md: D-16 y D-17 (cuentas), D-18 (tienda), D-21
// (estadísticas) y D-22 (amigos, chat e invitaciones).
//
// Las salas y la partida viven en Realtime Database: tienen sus propias
// reglas aparte.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Funciones de ayuda
    // ---------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Los ids de pareja son "uidA_uidB" (en orden alfabético).
    function inPair(pairId) {
      return signedIn() && request.auth.uid in pairId.split('_');
    }

    // El otro jugador de la pareja.
    function otherOf(pairId) {
      let parts = pairId.split('_');
      return parts[0] == request.auth.uid ? parts[1] : parts[0];
    }

    function areFriends(pairId) {
      let path = /databases/$(database)/documents/friendships/$(pairId);
      return exists(path) && get(path).data.status == 'accepted';
    }

    // Si [blocker] bloqueó al jugador que hace la petición.
    function blockedBy(blocker) {
      return exists(
        /databases/$(database)/documents/blocks/$(blocker + '_' + request.auth.uid)
      );
    }

    // Administradores (D-27): su documento admins/{uid} solo se crea a mano
    // desde la consola de Firebase.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---------------------------------------------------------------------
    // Cartera del perfil (D-28)
    // ---------------------------------------------------------------------

    // También ownedEyes (D-29) y ownedMouths (D-30): los ojos y las bocas
    // comprados solo cambian al comprar.
    function walletKeys() {
      return ['coins', 'diamonds', 'extraDice', 'experience', 'ownedEyes',
              'ownedMouths'];
    }

    function ownedEyesBefore() {
      return resource.data.get('ownedEyes', []);
    }

    function ownedEyesAfter() {
      return request.resource.data.get('ownedEyes', []);
    }

    function ownedEyesUnchanged() {
      return ownedEyesAfter() == ownedEyesBefore();
    }

    function ownedMouthsBefore() {
      return resource.data.get('ownedMouths', []);
    }

    function ownedMouthsAfter() {
      return request.resource.data.get('ownedMouths', []);
    }

    function ownedMouthsUnchanged() {
      return ownedMouthsAfter() == ownedMouthsBefore();
    }

    // Cuánto cambia [key] con esta escritura (lo que falta cuenta como 0).
    function delta(key) {
      return request.resource.data.get(key, 0) - resource.data.get(key, 0);
    }

    function touchesWallet() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(walletKeys());
    }

    function walletIsEmpty() {
      return request.resource.data.get('coins', 0) == 0
        && request.resource.data.get('diamonds', 0) == 0
        && request.resource.data.get('extraDice', 0) == 0
        && request.resource.data.get('experience', 0) == 0
        && request.resource.data.get('ownedEyes', []).size() == 0
        && request.resource.data.get('ownedMouths', []).size() == 0;
    }

    // Compra de un cofre (D-18). Los precios (50, 100 y 150) y el premio de
    // 100 monedas son los de lib/models/chest.dart: si cambian allá, hay
    // que cambiarlos aquí.
    function isChestPurchase() {
      let spent = resource.data.get('diamonds', 0)
        - request.resource.data.get('diamonds', 0);
      return (spent == 50 || spent == 100 || spent == 150)
        && request.resource.data.diamonds >= 0
        && delta('experience') == 0
        && ((ownedEyesUnchanged() && ownedMouthsUnchanged()
            && ((delta('coins') == 0 && delta('extraDice') == 0)
              || (delta('coins') == 100 && delta('extraDice') == 0)
              || (delta('coins') == 0 && delta('extraDice') == 1)))
          || (delta('coins') == 0 && delta('extraDice') == 0
            && ((addsOneEyes() && ownedMouthsUnchanged())
              || (addsOneMouth() && ownedEyesUnchanged()))));
    }

    // El cofre puede regalar un cosmético (D-31): se agrega exactamente uno
    // que se vende en la Tienda y no se cobra nada más que el cofre.
    function addsOneEyes() {
      let added = ownedEyesAfter().removeAll(ownedEyesBefore());
      return ownedEyesAfter().hasAll(ownedEyesBefore())
        && added.size() == 1
        && ownedEyesAfter().size() == ownedEyesBefore().size() + 1
        && eyesPrice(added[0]) > 0;
    }

    function addsOneMouth() {
      let added = ownedMouthsAfter().removeAll(ownedMouthsBefore());
      return ownedMouthsAfter().hasAll(ownedMouthsBefore())
        && added.size() == 1
        && ownedMouthsAfter().size() == ownedMouthsBefore().size() + 1
        && mouthPrice(added[0]) > 0;
    }

    // Premios de una partida: en la misma transacción se crea la marca
    // stats/{uid}/matches/{id} (así se cobra una sola vez) y el perfil
    // anota ese id en lastRewardMatch. Lo que se suma tiene que ser
    // exactamente lo del jugador en matchResults/{id}.
    function isMatchReward(uid) {
      let id = request.resource.data.get('lastRewardMatch', '');
      let marker = /databases/$(database)/documents/stats/$(uid)/matches/$(id);
      let record = /databases/$(database)/documents/matchResults/$(id);
      return id is string && id != ''
        && !exists(marker) && existsAfter(marker)
        && exists(record)
        && delta('extraDice') == 0
        && ownedEyesUnchanged()
        && ownedMouthsUnchanged()
        && rewardMatches(get(record).data.players, uid);
    }

    // El jugador [uid] está en algún puesto de [players] (máximo 6) y lo
    // que se suma es lo que dice ese puesto.
    function rewardMatches(players, uid) {
      return rewardAt(players, 0, uid) || rewardAt(players, 1, uid)
        || rewardAt(players, 2, uid) || rewardAt(players, 3, uid)
        || rewardAt(players, 4, uid) || rewardAt(players, 5, uid);
    }

    function rewardAt(players, i, uid) {
      return players.size() > i
        && players[i].uid == uid
        && delta('coins') == players[i].coins
        && delta('diamonds') == players[i].diamonds
        && delta('experience') == players[i].experience;
    }

    // Precio en monedas de cada ojo de la Tienda (D-29). Son los de
    // lib/models/eye_style.dart: si cambian allá, hay que cambiarlos aquí.
    // Los que no están (2, 5 y 7) son gratis y no se compran.
    function eyesPrice(number) {
      return {'1': 30, '3': 45, '4': 45, '6': 45, '8': 60, '9': 60,
              '10': 60, '11': 100}.get(string(number), 0);
    }

    // Compra de unos ojos: se agrega exactamente un ojo que no tenía (y que
    // se vende) y se resta exactamente su precio. Nada más cambia.
    function isEyesPurchase() {
      let added = ownedEyesAfter().removeAll(ownedEyesBefore());
      return ownedEyesAfter().hasAll(ownedEyesBefore())
        && added.size() == 1
        && ownedEyesAfter().size() == ownedEyesBefore().size() + 1
        && eyesPrice(added[0]) > 0
        && ownedMouthsUnchanged()
        && delta('coins') == -eyesPrice(added[0])
        && request.resource.data.coins >= 0
        && delta('diamonds') == 0
        && delta('extraDice') == 0
        && delta('experience') == 0;
    }

    // Los ojos que se pone el jugador tienen que ser gratis o comprados.
    function eyesOwned() {
      return request.resource.data.eyes in [2, 5, 7]
        || request.resource.data.eyes in ownedEyesAfter();
    }

    // Al crear la cuenta, si trae ojos, son de los gratis.
    function eyesAllowedOnCreate() {
      return !request.resource.data.keys().hasAny(['eyes']) || eyesOwned();
    }

    // Solo se revisa si cambian los ojos puestos.
    function eyesChangeAllowed() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['eyes'])
        || eyesOwned();
    }

    // Precio en monedas de cada boca de la Tienda (D-30). Son los de
    // lib/models/mouth_style.dart: si cambian allá, hay que cambiarlos aquí.
    // Los que no están (1 y 3) son gratis y no se compran.
    function mouthPrice(number) {
      return {'2': 30, '4': 30, '5': 45, '6': 45, '7': 60, '8': 60, '9': 75,
              '10': 75}.get(string(number), 0);
    }

    // Compra de una boca: se agrega exactamente una boca que no tenía (y que
    // se vende) y se resta exactamente su precio. Nada más cambia.
    function isMouthPurchase() {
      let added = ownedMouthsAfter().removeAll(ownedMouthsBefore());
      return ownedMouthsAfter().hasAll(ownedMouthsBefore())
        && added.size() == 1
        && ownedMouthsAfter().size() == ownedMouthsBefore().size() + 1
        && mouthPrice(added[0]) > 0
        && ownedEyesUnchanged()
        && delta('coins') == -mouthPrice(added[0])
        && request.resource.data.coins >= 0
        && delta('diamonds') == 0
        && delta('extraDice') == 0
        && delta('experience') == 0;
    }

    // La boca que se pone el jugador tiene que ser gratis o comprada.
    function mouthOwned() {
      return request.resource.data.mouth in [1, 3]
        || request.resource.data.mouth in ownedMouthsAfter();
    }

    // Al crear la cuenta, si trae boca, es de las gratis.
    function mouthAllowedOnCreate() {
      return !request.resource.data.keys().hasAny(['mouth']) || mouthOwned();
    }

    // Solo se revisa si cambia la boca puesta.
    function mouthChangeAllowed() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['mouth'])
        || mouthOwned();
    }

    // Topes de lo que una partida puede dar a cada jugador. La XP máxima
    // sale de ExperienceCalculator (1.er puesto, 6 jugadores, 25 rondas =
    // 280); los otros son holgados porque se ajustan con el diseño.
    function playerWithinLimits(players, i) {
      return players.size() <= i
        || (players[i].coins is int && players[i].coins >= 0
          && players[i].coins <= 10000
          && players[i].diamonds is int && players[i].diamonds >= 0
          && players[i].diamonds <= 100
          && players[i].experience is int && players[i].experience >= 0
          && players[i].experience <= 300);
    }

    function playersWithinLimits(players) {
      return playerWithinLimits(players, 0) && playerWithinLimits(players, 1)
        && playerWithinLimits(players, 2) && playerWithinLimits(players, 3)
        && playerWithinLimits(players, 4) && playerWithinLimits(players, 5);
    }

    // ---------------------------------------------------------------------
    // Administración (D-27)
    // ---------------------------------------------------------------------

    // Cada uno puede saber si él mismo es administrador. Nadie lo puede
    // crear ni cambiar desde la app.
    match /admins/{uid} {
      allow get: if isUser(uid);
      allow list, write: if false;
    }

    // ---------------------------------------------------------------------
    // Cuentas (D-16, D-17, D-18)
    // ---------------------------------------------------------------------

    // Perfil privado: solo su dueño (tiene el correo). Los administradores
    // pueden leerlos para las estadísticas de la app.
    //
    // La cartera (monedas, diamantes, dados extra y XP) no se escribe a
    // mano (D-28): empieza en 0 y solo cambia al comprar un cofre, al
    // cobrar los premios de una partida registrada o desde el panel de
    // administración.
    match /users/{uid} {
      allow read: if isUser(uid) || isAdmin();
      allow create: if isUser(uid) && walletIsEmpty()
        && eyesAllowedOnCreate() && mouthAllowedOnCreate();
      allow update: if isUser(uid) && eyesChangeAllowed()
        && mouthChangeAllowed()
        && (!touchesWallet() || isAdmin() || isChestPurchase()
            || isMatchReward(uid) || isEyesPurchase() || isMouthPurchase());
      allow delete: if isUser(uid);
    }

    // Reserva del nombre de usuario. Se lee sin sesión para poder iniciar
    // sesión con el nombre, pero solo por nombre exacto (get), nunca la
    // lista completa: tiene correos y hay jugadores menores.
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if isUser(request.resource.data.uid);
      allow update, delete: if isUser(resource.data.uid);
    }

    // Reserva del código de amistad. Se busca por código exacto para
    // agregar amigos.
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isUser(request.resource.data.uid);
      allow delete: if isUser(resource.data.uid);
    }

    // ---------------------------------------------------------------------
    // Estadísticas (D-21)
    // ---------------------------------------------------------------------

    match /stats/{uid} {
      allow read: if isUser(uid) || isAdmin();
      allow write: if isUser(uid);

      // Marca de una partida ya sumada. No se cambia ni se borra: si se
      // pudiera borrar, los premios de esa partida se cobrarían otra vez
      // (D-28).
      match /matches/{matchId} {
        allow read: if isUser(uid);
        allow create: if isUser(uid);
        allow update, delete: if false;
      }
    }

    // ---------------------------------------------------------------------
    // Resultados de partidas (results_system.md)
    // ---------------------------------------------------------------------

    // Registro de cada partida terminada, para rankings e historial. Lo crea
    // una sola vez el anfitrión, que tiene que haber jugado. No se edita ni
    // se borra. Como de aquí salen los premios de cada jugador (D-28), lo
    // de cada uno tiene topes.
    match /matchResults/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.roomId == roomId
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.schemaVersion == 1
        && request.resource.data.playerIds is list
        && request.auth.uid in request.resource.data.playerIds
        && request.resource.data.playerIds.size() <= 6
        && request.resource.data.players is list
        && request.resource.data.players.size()
          == request.resource.data.playerIds.size()
        && playersWithinLimits(request.resource.data.players);
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // Amigos, chat e invitaciones (D-22)
    // ---------------------------------------------------------------------

    // Lo que ven los demás: sin correo.
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow write: if isUser(uid);
    }

    // Solicitudes y amistades. "get" va por id (así se puede leer aunque
    // todavía no exista, al enviar la solicitud); "list" va por members
    // (la consulta de la lista de amigos).
    match /friendships/{pairId} {
      allow get: if inPair(pairId);
      allow list: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if inPair(pairId)
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.members.hasAll(pairId.split('_'))
        && !blockedBy(otherOf(pairId));

      // Aceptar: solo se puede cambiar el estado.
      allow update: if inPair(pairId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status']);

      // Rechazar, cancelar, eliminar o bloquear.
      allow delete: if inPair(pairId);
    }

    match /chats/{pairId} {
      allow get, write: if inPair(pairId);
      allow list: if signedIn() && request.auth.uid in resource.data.members;

      match /messages/{messageId} {
        allow read: if inPair(pairId);
        // Solo entre amigos, a nombre propio, de máximo 200 caracteres y si
        // el otro no te bloqueó.
        allow create: if inPair(pairId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 200
          && areFriends(pairId)
          && !blockedBy(otherOf(pairId));
      }
    }

    match /invites/{inviteId} {
      // El invitado ve sus invitaciones y solo puede marcarlas como vistas.
      allow read: if signedIn() && resource.data.toUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['seen']);

      // Solo a amigos que no te bloquearon.
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && areFriends(
             request.auth.uid < request.resource.data.toUid
               ? request.auth.uid + '_' + request.resource.data.toUid
               : request.resource.data.toUid + '_' + request.auth.uid)
        && !blockedBy(request.resource.data.toUid);
    }

    // Bloqueos: el id es "bloqueador_bloqueado".
    match /blocks/{blockId} {
      // Se consulta por id para saber si alguien te bloqueó.
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.blocker == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.blocker == request.auth.uid
        && blockId == request.auth.uid + '_' + request.resource.data.blocked;
      allow delete: if signedIn() && resource.data.blocker == request.auth.uid;
    }

    // Reportes: se pueden crear, pero nadie los lee desde la app (los
    // revisa un adulto o el docente en la consola de Firebase).
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid;
    }
  }
}