<?xml version="1.0" encoding="utf-8"?>
<!-- H-05: Android 12 o más. Con allowBackup="false" ya no hay copia en la
     nube, pero el paso a un celular nuevo (device-transfer) sí copiaría los
     datos: aquí se excluye todo en los dos casos. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
